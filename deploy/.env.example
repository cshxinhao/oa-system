DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=example.com,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_STATIC_ROOT=/opt/oa-system/shared/staticfiles
DJANGO_MEDIA_ROOT=/data/oa-system/media
DJANGO_SQLITE_PATH=/data/oa-system/db.sqlite3
CORS_ALLOW_ALL_ORIGINS=0
CORS_ALLOWED_ORIGINS=https://example.com
DISABLED_MODULES=finance,trading

# Email notifications (Microsoft 365 SMTP — leave@avenue.limited mailbox)
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=leave@avenue.limited
EMAIL_HOST_PASSWORD=replace-with-m365-app-password
EMAIL_DEFAULT_FROM=leave@avenue.limited
EMAIL_TIMEOUT=15
SITE_URL=https://oasystem.avenue.limited
